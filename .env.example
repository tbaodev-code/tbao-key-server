# ==========================================
# TBAO TEAM LICENSE SERVER - CONFIG TEMPLATE
# Sao chép file này thành .env và điền thông tin của bạn
# ==========================================

# Cấu hình CSDL Turso (libSQL) hoặc SQLite cục bộ
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token-here

# Tài khoản Quản trị viên Dashboard
ADMIN_USER=admin
ADMIN_PASS=YOUR_STRONG_PASSWORD_HERE

# Bảo mật phiên làm việc (Session Secret)
SESSION_SECRET=your-random-session-secret-key-32-chars
PORT=3000
